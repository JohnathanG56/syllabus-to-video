# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Set this to a CURRENT Claude model id from https://docs.anthropic.com/en/docs/about-claude/models
# (e.g. the latest Sonnet). Left blank on purpose: model ids change, so pick one when you run it.
LLM_MODEL=
# LLM_MAX_TOKENS=8000
# LLM_TEMPERATURE=0.2

# --- Rendering ---
# docker = sandboxed (recommended). local = runs LLM code directly on your machine (UNSAFE, dev only).
RENDER_BACKEND=docker
SANDBOX_IMAGE=stv-manim-sandbox:latest
# MAX_REPAIRS=3
# VALIDATE_TIMEOUT_S=180
# FINAL_TIMEOUT_S=600
# RENDER_CONCURRENCY=2

# --- Narration (Piper TTS) ---
# auto = python `piper` package if installed, else PIPER_BIN, else error.
TTS_BACKEND=auto
PIPER_VOICE=voices/en_US-lessac-medium.onnx
# PIPER_BIN=/path/to/piper   # only for the standalone C++ piper binary
# PIPER_LENGTH_SCALE=1.1     # >1 = slower, calmer narration

# --- Output ---
# BURN_CAPTIONS=0   # 1 = burn subtitles into the video (needs ffmpeg with libass)
# MAX_TOPICS=8      # cap topics per syllabus to bound cost
